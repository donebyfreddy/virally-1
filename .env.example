# =============================================================================
# VIRALLY — environment template
#
# Copy to `.env.local` and fill in. `.env*` is gitignored; never commit a filled
# copy, and never paste a real value into this file.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# readable by every visitor. Everything else is server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Neon Postgres
# Get this from the Neon console (Connection Details) or `npx neonctl@latest
# connection-string <project-id>`. Never a client-side variable.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-example-000000-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# REQUIRED — Better Auth
# Session/cookie signing secret. Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=

# Google OAuth login (Google Cloud Console → APIs & Services → Credentials).
# Distinct from META_APP_ID / TIKTOK / GOOGLE_CLIENT_ID below, which are for
# connecting social publishing accounts, not for signing users in.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED IN DEPLOYED ENVIRONMENTS — canonical origin
#
# Used to build OAuth and email redirect URLs, and as Better Auth's baseURL.
# Must also be allow-listed as an authorized redirect URI in the Google OAuth
# client:
#   <origin>/api/auth/callback/google
#
# Falls back to the request origin in local development.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# NOT YET REQUIRED — later phases
#
# The application boots and runs without every variable below. Each provider is
# feature-detected: when its key is absent the feature reports itself as
# unconfigured rather than failing or pretending to work.
# =============================================================================

# --- AI providers (Phase 5 uses a deterministic mock when these are absent) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=

# --- Transactional email (Phase 10 team invitations) -------------------------
RESEND_API_KEY=

# --- Queue backend (Phase 8). Absent → Postgres-backed queue + local worker --
REDIS_URL=

# --- Social platforms (Phase 11) --------------------------------------------
# Each also requires platform app review before production publishing. Absent
# credentials render the connector as "Configuration required" — never as a
# working button.
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
