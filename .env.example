# =============================================================================
# VIRALLY — environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is
# committed and must never contain a real secret.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Neon Postgres
#
# Server-only. Never prefix with NEXT_PUBLIC_ and never log it: the pooled
# connection string carries the role's real password, so a leak is a full
# database compromise.
#
# Provision with `npx neonctl@latest init`, or copy the pooled connection
# string from the Neon console (Dashboard -> Connection Details).
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# REQUIRED — Better Auth session/cookie signing secret
#
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED — canonical origin for OAuth and email redirects
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# =============================================================================
# OPTIONAL — later phases. The app boots and runs without every value here.
# Each is feature-detected: an absent key makes the feature report itself as
# unconfigured rather than failing or pretending to work.
# =============================================================================

# --- AI providers. Absent -> deterministic mock, outputs labelled "Demo". ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=

# --- Magnific (image / video / music generation) -----------------------------
#
# Server-only. Never NEXT_PUBLIC_, never logged, never returned from a server
# action. Read exclusively through src/lib/creative/env.ts, which is the only
# module permitted to touch these values.
#
# Absent -> MockCreativeProvider runs, every asset is marked `origin: "mock"`
# and labelled "Demo output". The app boots and the full campaign + editing
# flow stays exercisable; only real generation is unavailable.
#
# Issue both from https://www.magnific.com/user/api-keys
# -----------------------------------------------------------------------------
MAGNIFIC_API_KEY=

# The HMAC-SHA256 secret Magnific issues ALONGSIDE the API key — it is a
# different value, not the key itself. Used only to verify inbound webhook
# signatures over `webhook-id.webhook-timestamp.body`.
#
# Absent -> /api/webhooks/magnific refuses every request and generation falls
# back to controlled polling. An unverified webhook is an unauthenticated
# write path into the job table, so it is never accepted without this.
MAGNIFIC_WEBHOOK_SECRET=

# --- MuAPI (image / video / audio / lip-sync generation) ---------------------
#
# Server-only, same rules as MAGNIFIC_API_KEY: never NEXT_PUBLIC_, never
# logged, never returned from a server action, read only through
# src/lib/creative/env.ts.
#
# A SECOND provider, not a replacement. Magnific stays fully supported; the
# router picks between them on capability, price and availability, and Virally
# boots and generates normally with either, both, or neither set.
#
# Absent -> MuAPI is skipped during routing and the settings surface reports
# "Provider configuration required" naming this variable. If no provider is
# configured at all, the deterministic mock runs and every output is labelled
# "Demo output".
#
# Issue from https://muapi.ai/access-keys
#
# NOTE: MuAPI has no webhook signing secret to configure. It supports a
# `webhook` callback parameter but publishes no signature scheme, so Virally
# treats an inbound MuAPI webhook as an untrusted hint that merely schedules an
# earlier poll — never as a state transition. The authenticated outbound poll
# stays the only source of truth. There is deliberately no MUAPI_WEBHOOK_SECRET.
#
# Upstream open-source tooling calls this variable MUAPI_KEY. Virally does not.
MUAPI_API_KEY=

# --- Transactional email (team invitations) ----------------------------------
RESEND_API_KEY=

# --- Queue backend. Absent -> Postgres-backed queue + local worker. ---------
REDIS_URL=

# --- Queue drain authorisation ----------------------------------------------
#
# Shared secret for POST /api/cron/generation, the endpoint that drains the
# generation queue. It acts across every workspace and has no user session, so
# a shared secret is what protects it.
#
# Absent -> the endpoint refuses every request and the queue never drains.
# CLOSED, not open: a deployment that forgot this gets generations that stay
# queued, which is visible and fixable. Treating "unset" as "no auth required"
# is the failure that only shows up as an unexplained provider bill.
#
# Generate with: openssl rand -base64 32
# Send as: Authorization: Bearer <value>
CRON_SECRET=

# --- Social platforms. Also require platform app review before production. ---
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Demo seeding. Never enable in production. ------------------------------
VIRALLY_ENABLE_DEMO_SEED=
