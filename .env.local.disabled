# =============================================================================
# VIRALLY — local environment
#
# Fill in the values below. This file is gitignored (`.env*` in web/.gitignore)
# and must never be committed. `.env.example` is the committed template.
#
# Next.js loads `.env.local` ahead of `.env`, and it is the conventional home
# for real credentials. Restart the dev server after editing — env vars are read
# at boot, not per request.
#
# Until NEXT_PUBLIC_SUPABASE_URL and a public key are set, the auth screens
# render a "Configuration required" notice with their submit buttons disabled,
# and the marketing site keeps working normally.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Supabase.  Project → Settings → API
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://vdnpelpgmngfzwytdxxy.supabase.co

# The project's PUBLIC key. Set exactly one of these two.
# (Supabase renamed `anon` to `publishable` in 2025; either works.)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_44DSjwjcYTAPdPcbjOLPkw_2zsHB0Lp

# Server-only. Bypasses row-level security completely — treat as a root
# password. Never prefix with NEXT_PUBLIC_. Needed for tenant bootstrap,
# migrations run from the app, queue workers and webhook ingestion.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by `npm run db:push` and the RLS tests.
# Project → Settings → Database → Connection string → URI.
# Use the pooled (port 6543) URI for the app and the direct (5432) URI here.
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# REQUIRED — canonical origin for OAuth and email redirects
#
# Must also be allow-listed in Supabase → Authentication → URL Configuration
# → Redirect URLs, exactly:
#     http://localhost:3000/auth/callback
#     http://localhost:3000/auth/confirm
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# OPTIONAL — later phases. The app boots and runs without every value here.
# Each is feature-detected: absent key → the feature reports itself as
# unconfigured rather than failing or pretending to work.
# =============================================================================

# --- AI providers. Absent → deterministic mock, outputs labelled "Demo". -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=

# --- Transactional email (team invitations) ----------------------------------
RESEND_API_KEY=

# --- Queue backend. Absent → Supabase-backed queue + local worker. ----------
REDIS_URL=

# --- Social platforms. Also require platform app review before production. ---
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Demo seeding. Never enable in production. ------------------------------
VIRALLY_ENABLE_DEMO_SEED=false
